:root {
    --blue: #2563EB;
    --violet: #7C3AED;
    --pink: #EC4899;
    --green: #22C55E;
    --orange: #F59E0B;
    --red: #EF4444;
    --cyan: #06B6D4;
    --amber: #FBBF24;
    --dark: #0F172A;
    --gray: #F1F5F9;
    --text: #334155;
    --text-light: #64748B;
    --white: #FAFBFD;
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--white);
    color: var(--dark);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

/* Navigation */
.nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(250, 251, 253, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 1000;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    transition: var(--transition);
}

.nav.scrolled {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
}

.nav-logo {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--dark);
    text-decoration: none;
    letter-spacing: -0.02em;
}

.nav-links {
    display: flex;
    gap: 32px;
}

.nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: var(--transition);
    position: relative;
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--blue);
    transition: var(--transition);
}

.nav-links a:hover {
    color: var(--blue);
}

.nav-links a:hover::after {
    width: 100%;
}

.nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
}

.nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--dark);
    transition: var(--transition);
}

/* Hero */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 120px 40px 80px;
    background: linear-gradient(135deg, var(--white) 0%, #EFF6FF 50%, var(--white) 100%);
    overflow: hidden;
}

.hero-bg {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(2deg); }
}

.hero-content {
    text-align: center;
    position: relative;
    z-index: 1;
    max-width: 800px;
}

.hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 24px;
    background: linear-gradient(135deg, var(--dark) 0%, var(--blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: fadeInUp 1s ease-out;
}

.hero-subtitle {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    color: var(--text);
    font-weight: 400;
    margin-bottom: 32px;
    animation: fadeInUp 1s ease-out 0.2s both;
}

.hero-line {
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, var(--blue), var(--violet));
    border-radius: 2px;
    margin: 0 auto 24px;
    animation: scaleIn 1s ease-out 0.4s both;
}

.hero-meta {
    font-size: 1rem;
    color: var(--text-light);
    animation: fadeInUp 1s ease-out 0.6s both;
}

/* Sections */
.section {
    padding: 100px 40px;
    position: relative;
}

.section-white {
    background: var(--white);
}

.section-gray {
    background: var(--gray);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

.section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    text-align: center;
}

.section-lead {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text);
    text-align: center;
    max-width: 600px;
    margin: 0 auto 60px;
    line-height: 1.6;
}

/* Cards */
.cards-grid {
    display: grid;
    gap: 24px;
}

.cards-grid.two {
    grid-template-columns: repeat(2, 1fr);
}

.cards-grid.three {
    grid-template-columns: repeat(3, 1fr);
}

.cards-grid.four {
    grid-template-columns: repeat(4, 1fr);
}

.card {
    background: white;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
}

.card-num {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
    color: white;
    margin-bottom: 20px;
}

.card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--dark);
}

.card h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--dark);
}

.card p {
    color: var(--text);
    line-height: 1.6;
}

.card-accent {
    width: 4px;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 20px 0 0 20px;
}

.card-small {
    padding: 24px;
}

.card-small .card-accent {
    width: 100%;
    height: 4px;
    top: 0;
    left: 0;
    border-radius: 20px 20px 0 0;
}

/* Table */
.table-wrapper {
    background: white;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    overflow-x: auto;
}

.models-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
}

.models-table th {
    background: var(--dark);
    color: white;
    padding: 16px;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
}

.models-table td {
    padding: 14px 16px;
    border-bottom: 1px solid #E2E8F0;
    color: var(--text);
}

.models-table tr:hover td {
    background: #F8FAFC;
}

/* Model Cards */
.models-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.model-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: var(--transition);
}

.model-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
}

.model-header {
    padding: 24px 32px;
    color: white;
}

.model-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 4px;
}

.model-header span {
    opacity: 0.9;
    font-size: 0.9rem;
}

.model-body {
    padding: 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

.model-col h4 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
}

.model-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.model-col li {
    position: relative;
    padding-left: 20px;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
}

.model-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
}

.model-col li.minuses::before {
    background: var(--red);
}

.model-col ul.minuses li::before {
    background: var(--red);
}

.info-card {
    background: var(--gray);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 16px;
}

.info-card h4 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
    color: var(--blue);
}

.info-card p {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
}

.info-card.free h4 {
    color: var(--green);
}

/* Features */
.features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
}

.feature-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 24px;
    background: white;
    border-radius: 16px;
    transition: var(--transition);
}

.feature-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.feature-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
}

.feature-item h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--dark);
}

.feature-item p {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
}

/* Badges */
.badge-container {
    text-align: center;
    margin-top: 32px;
}

.badge {
    display: inline-block;
    padding: 12px 24px;
    background: var(--green);
    color: white;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 600;
}

.text-muted {
    color: var(--text-light);
    margin-top: 12px;
    font-size: 0.9rem;
}

.text-block {
    max-width: 700px;
    margin: 32px auto 0;
    text-align: center;
}

.text-block p {
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1.7;
}

/* Departments */
.dept-section {
    margin-bottom: 40px;
}

.dept-header {
    padding: 24px 32px;
    border-radius: 20px 20px 0 0;
    color: white;
}

.dept-header h3 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
}

.dept-header span {
    opacity: 0.9;
    font-size: 0.9rem;
}

.dept-body {
    background: white;
    border-radius: 0 0 20px 20px;
    padding: 32px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

.dept-col h4 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
    color: var(--blue);
}

.dept-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.dept-col li {
    position: relative;
    padding-left: 16px;
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.5;
}

.dept-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
}

.prompt-box {
    background: var(--gray);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    position: relative;
    padding-left: 48px;
}

.prompt-num {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--blue);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
}

.prompt-box p {
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.5;
}

/* Recommendations */
.recommendations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.rec-card {
    background: white;
    border-radius: 20px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: var(--transition);
}

.rec-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
}

.rec-num {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
    color: white;
    margin-bottom: 16px;
}

.rec-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--dark);
}

.rec-card p {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
}

/* Footer */
.footer {
    background: var(--dark);
    color: white;
    padding: 40px;
    text-align: center;
}

.footer p {
    opacity: 0.7;
    font-size: 0.9rem;
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes scaleIn {
    from {
        opacity: 0;
        transform: scaleX(0);
    }
    to {
        opacity: 1;
        transform: scaleX(1);
    }
}

.card-animate {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
}

.card-animate.visible {
    opacity: 1;
    transform: translateY(0);
}

/* Responsive */
@media (max-width: 1024px) {
    .cards-grid.four {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .model-body {
        grid-template-columns: 1fr;
    }
    
    .dept-body {
        grid-template-columns: 1fr;
    }
    
    .recommendations-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .nav-links {
        display: none;
    }
    
    .nav-toggle {
        display: flex;
    }
    
    .hero {
        padding: 100px 20px 60px;
    }
    
    .section {
        padding: 60px 20px;
    }
    
    .cards-grid.two,
    .cards-grid.three,
    .cards-grid.four {
        grid-template-columns: 1fr;
    }
    
    .features-grid {
        grid-template-columns: 1fr;
    }
    
    .recommendations-grid {
        grid-template-columns: 1fr;
    }
    
    .model-body {
        padding: 24px;
    }
    
    .dept-body {
        padding: 24px;
    }
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--white);
}

::-webkit-scrollbar-thumb {
    background: #CBD5E1;
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: #94A3B8;
}

/* Selection */
::selection {
    background: rgba(37, 99, 235, 0.2);
    color: var(--dark);
}