//@version=6
strategy("Structure Universal", shorttitle="StructUni", overlay=true, 
         max_lines_count=500, max_labels_count=200, max_boxes_count=100,
         default_qty_type=strategy.percent_of_equity, default_qty_value=10,
         commission_type=strategy.commission.percent, commission_value=0.025)

// ═══════════════════════════════════════════════════════════════
//  УНИВЕРСАЛЬНАЯ СТРАТЕГИЯ: выбор свингов и режима выхода
// ═══════════════════════════════════════════════════════════════

// ─── СВИНГИ ─────────────────────────────────────────────────
swing_left  = input.int (8, "Swing Left (бар)", minval=1, maxval=50, tooltip="Баров слева для подтверждения свинга")
swing_right = input.int (8, "Swing Right (бар)", minval=1, maxval=50, tooltip="Баров справа. Меньше = раньше сигнал, больше ложных")

// ─── РЕЖИМ ВЫХОДА ─────────────────────────────────────────
exit_mode   = input.string("Fixed TP", "Режим выхода", options=["Fixed TP", "Trailing ATR", "Time Exit", "Fixed + Time"],
             tooltip="Fixed TP = фикс. тейк-профит. Trailing ATR = подтягивающийся стоп. Time Exit = закрытие по времени. Fixed+Time = оба")

// ─── ПАРАМЕТРЫ СТОПА / ТЕЙКА ──────────────────────────────
atr_len     = input.int (14, "ATR Period")
atr_mult    = input.float(1.0, "ATR × (начальный стоп)", step=0.1)
tp_ratio    = input.float(1.5, "TP Ratio (× риск)", step=0.1)
trail_mult  = input.float(1.5, "Trailing ATR Multiplier", step=0.1, tooltip="Для Trailing ATR режима")
time_bars   = input.int (48, "Time Exit (баров)", minval=5, tooltip="~4 часа для 5-минуток")

// ─── ВИЗУАЛИЗАЦИЯ ─────────────────────────────────────────
show_rays   = input.bool(true, "Лучи свингов")
col_bull    = input.color(color.new(#00e676, 0),  "Лонг")
col_bear    = input.color(color.new(#ff3b3b, 0),  "Шорт")
col_ray     = input.color(color.new(#ffd700, 55), "Лучи")

// ─── СВИНГИ (асимметричные) ───────────────────────────────
ph = ta.pivothigh(high, swing_left, swing_right)
pl = ta.pivotlow (low,  swing_left, swing_right)

var float sh1 = na, var float sh2 = na, var float sh3 = na
var float sl1 = na, var float sl2 = na, var float sl3 = na

var bool longFired  = false
var bool shortFired = false

if not na(ph)
    sh3 := sh2, sh2 := sh1, sh1 := ph
    shortFired := false

if not na(pl)
    sl3 := sl2, sl2 := sl1, sl1 := pl
    longFired := false

// ─── СИГНАЛЫ ────────────────────────────────────────────────
longCond  = not na(pl) and not na(sl1) and not na(sl2) and not na(sl3) and not longFired
longStr   = sl3 > sl2 and sl1 > sl2
longSig   = longCond and longStr

shortCond = not na(ph) and not na(sh1) and not na(sh2) and not na(sh3) and not shortFired
shortStr  = sh3 < sh2 and sh1 < sh2
shortSig  = shortCond and shortStr

if longSig
    longFired := true
if shortSig
    shortFired := true

// ─── ATR ───────────────────────────────────────────────────
atrVal = ta.atr(atr_len)

// ─── ВХОДЫ ─────────────────────────────────────────────────
var float longStop   = na
var float longTarget = na
var float shortStop  = na
var float shortTarget= na
var int   longEntryBar = na
var int   shortEntryBar = na

if longSig and strategy.position_size <= 0
    risk       = atrVal * atr_mult
    entry      = close
    longStop   := entry - risk
    longTarget := entry + risk * tp_ratio
    longEntryBar := bar_index
    strategy.entry("Long", strategy.long)

if shortSig and strategy.position_size >= 0
    risk        = atrVal * atr_mult
    entry       = close
    shortStop   := entry + risk
    shortTarget := entry - risk * tp_ratio
    shortEntryBar := bar_index
    strategy.entry("Short", strategy.short)

// ─── ВЫХОДЫ ─────────────────────────────────────────────────
// Fixed TP
if exit_mode == "Fixed TP" or exit_mode == "Fixed + Time"
    if strategy.position_size > 0 and not na(longStop) and not na(longTarget)
        strategy.exit("LongX", from_entry="Long", stop=longStop, limit=longTarget)
    if strategy.position_size < 0 and not na(shortStop) and not na(shortTarget)
        strategy.exit("ShortX", from_entry="Short", stop=shortStop, limit=shortTarget)

// Trailing ATR — обновляем стоп на каждом баре
if exit_mode == "Trailing ATR"
    if strategy.position_size > 0 and not na(longStop)
        newStop = close - atrVal * trail_mult
        longStop := math.max(longStop, newStop)
        strategy.exit("LongX", from_entry="Long", stop=longStop)
    if strategy.position_size < 0 and not na(shortStop)
        newStop = close + atrVal * trail_mult
        shortStop := math.min(shortStop, newStop)
        strategy.exit("ShortX", from_entry="Short", stop=shortStop)

// Time Exit — закрываем если прошло N баров
if exit_mode == "Time Exit" or exit_mode == "Fixed + Time"
    if strategy.position_size > 0 and not na(longEntryBar) and (bar_index - longEntryBar >= time_bars)
        strategy.close("Long", comment="Time")
    if strategy.position_size < 0 and not na(shortEntryBar) and (bar_index - shortEntryBar >= time_bars)
        strategy.close("Short", comment="Time")

// ─── ВИЗУАЛИЗАЦИЯ ───────────────────────────────────────────
plotshape(longSig,  "LONG",  style=shape.triangleup,   location=location.belowbar, color=col_bull, size=size.large, offset=-swing_left)
plotshape(shortSig, "SHORT", style=shape.triangledown, location=location.abovebar, color=col_bear, size=size.large, offset=-swing_left)

// Лучи свингов
var line[]  ray_lines  = array.new<line>()
var float[] ray_levels = array.new<float>()
var label[] ray_labels = array.new<label>()

if show_rays and not na(ph)
    isHH = not na(sh2) and ph > sh2
    lbl  = isHH ? "HH" : "LH"
    lcol = isHH ? col_bull : col_bear
    array.push(ray_lines,  line.new(bar_index - swing_left, ph, bar_index, ph, color=col_ray, width=1, style=line.style_dashed))
    array.push(ray_levels, ph)
    array.push(ray_labels, label.new(bar_index - swing_left, ph, text=lbl, style=label.style_label_down, color=color.new(lcol, 30), textcolor=color.white, size=size.small))

if show_rays and not na(pl)
    isLL = not na(sl2) and pl < sl2
    lbl  = isLL ? "LL" : "HL"
    lcol = isLL ? col_bear : col_bull
    array.push(ray_lines,  line.new(bar_index - swing_left, pl, bar_index, pl, color=col_ray, width=1, style=line.style_dashed))
    array.push(ray_levels, pl)
    array.push(ray_labels, label.new(bar_index - swing_left, pl, text=lbl, style=label.style_label_up, color=color.new(lcol, 30), textcolor=color.white, size=size.small))

if show_rays and array.size(ray_lines) > 0
    i = 0
    while i < array.size(ray_lines)
        lvl    = array.get(ray_levels, i)
        ray_ln = array.get(ray_lines,  i)
        ray_lb = array.get(ray_labels, i)
        body_top = math.max(open, close)
        body_bot = math.min(open, close)
        if body_bot < lvl and body_top > lvl
            line.delete(ray_ln), label.delete(ray_lb)
            array.remove(ray_lines,  i)
            array.remove(ray_levels, i)
            array.remove(ray_labels, i)
        else
            line.set_x2(ray_ln, bar_index)
            i += 1

// ─── ALERTS ──────────────────────────────────────────────────
alertcondition(longSig,  "LONG",  "Structure Universal LONG")
alertcondition(shortSig, "SHORT", "Structure Universal SHORT")
